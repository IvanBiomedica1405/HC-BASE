# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: úsala únicamente en scripts de carga (seed) y nunca en código del navegador
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del portal (para enlaces y PWA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: enlace base del workspace de Notion para los botones "Abrir en Notion"
NEXT_PUBLIC_NOTION_BASE_URL=
